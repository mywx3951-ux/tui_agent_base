# OpenRouter（统一网关，可路由到多家的模型）
# 注册：https://openrouter.ai/  ->  Keys -> Create Key
# 免费额度模型示例：deepseek/deepseek-chat-v3.1:free
OPENAI_API_KEY=sk-or-v1-你的openrouter密钥
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat-v3.1:free

# 国内直连备选（二选一即可，需要自己充值/实名）：
# DeepSeek   OPENAI_BASE_URL=https://api.deepseek.com/v1        OPENAI_MODEL=deepseek-chat
# 阿里百炼   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
# 月之暗面   OPENAI_BASE_URL=https://api.moonshot.cn/v1         OPENAI_MODEL=moonshot-v1-8k
